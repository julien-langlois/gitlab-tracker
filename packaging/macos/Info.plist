<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist of "GitLab Tracker.app" (packaging/macos/dmg.sh fills @VERSION@).
  Opened from the Finder, the binary has no terminal and opens the window
  (cli::window_without_terminal).
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>GitLab Tracker</string>
  <key>CFBundleDisplayName</key>
  <string>GitLab Tracker</string>
  <key>CFBundleIdentifier</key>
  <string>com.gitlab-tracker.gitlab-tracker</string>
  <key>CFBundleExecutable</key>
  <string>gitlab-tracker</string>
  <key>CFBundleIconFile</key>
  <string>gitlab-tracker</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
